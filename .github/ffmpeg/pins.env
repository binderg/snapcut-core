# The FFmpeg bundled into every ve release archive. LGPL only: no x264/x265,
# never ffmpeg-sidecar's GPL download. Sourced by bash in the workflows.
#
# To change FFmpeg: edit the pins below, bump FFMPEG_RELEASE (a new tag, e.g.
# ffmpeg-8.1.4-1), run the "FFmpeg" workflow by hand (Actions tab), then
# commit. Release and nightly builds read FFMPEG_RELEASE, nothing else here.

# Our own release holding the repackaged binaries, sources and SHA256SUMS.txt.
FFMPEG_RELEASE=ffmpeg-8.1.3-1

# FFmpeg source: release/8.1 branch at n8.1.3-24. Every platform builds from it.
FFMPEG_COMMIT=92611900bb112123e9bf997fdcc2d78e4c4922fc
FFMPEG_SRC_URL=https://github.com/FFmpeg/FFmpeg/archive/92611900bb112123e9bf997fdcc2d78e4c4922fc.tar.gz
FFMPEG_SRC_SHA256=12c02b1eaf52ec310acae385e76810f4bb71bacc21cacc01d6d9e95ac3b83bbb

# Linux and Windows: BtbN's static "lgpl" builds of that commit. BtbN prunes old
# autobuilds, which is why we copy them into FFMPEG_RELEASE.
BTBN_TAG=autobuild-2026-10-26-14-25
BTBN_COMMIT=b4a2b1d7cc241786eb8e2b588a7ade40cad48bbd
BTBN_X86_64_UNKNOWN_LINUX_GNU=ffmpeg-n8.1.3-24-g92611900bb-linux64-lgpl-8.1.tar.xz
BTBN_X86_64_UNKNOWN_LINUX_GNU_SHA256=d0a6ee27c8b1c2d1dd43de192ccfc3f548e9a774ce41ddd890c568402d659cc1
BTBN_AARCH64_UNKNOWN_LINUX_GNU=ffmpeg-n8.1.3-24-g92611900bb-linuxarm64-lgpl-8.1.tar.xz
BTBN_AARCH64_UNKNOWN_LINUX_GNU_SHA256=931815e2883da8e3feb114b4b5d2dff9f47c60e9630490e6927d8e9d80caff5b
BTBN_X86_64_PC_WINDOWS_MSVC=ffmpeg-n8.1.3-24-g92611900bb-win64-lgpl-8.1.zip
BTBN_X86_64_PC_WINDOWS_MSVC_SHA256=9b1907a3871eed4564ee745f04cc53c8713f3db7b3e2bed7805da3521769901a

# macOS: no LGPL builds to reuse, so build-macos.sh builds these statically.
LAME_URL=https://downloads.sourceforge.net/project/lame/lame/3.100/lame-3.100.tar.gz
LAME_SHA256=ddfe36cab873794038ae2c1210557ad34857a4b6bdc515785d1da9e175b1da1e
OPUS_URL=https://downloads.xiph.org/releases/opus/opus-1.5.2.tar.gz
OPUS_SHA256=65c1d2f78b9f2fb20082c38cbe47c951ad5839345876e46941612ee87f9a7ce1
VPX_URL=https://github.com/webmproject/libvpx/archive/refs/tags/v1.15.2.tar.gz
VPX_SHA256=26fcd3db88045dee380e581862a6ef106f49b74b6396ee95c2993a260b4636aa
OPENH264_URL=https://github.com/cisco/openh264/archive/refs/tags/v2.6.0.tar.gz
OPENH264_SHA256=558544ad358283a7ab2930d69a9ceddf913f4a51ee9bf1bfb9e377322af81a69
