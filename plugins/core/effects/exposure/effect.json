{
  "id": "core.color/exposure",
  "version": "1.0.0",
  "kind": "effect",
  "runtime": "wgsl",
  "name": "Exposure",
  "description": "Brighten or darken in photographic stops.",
  "shader": "effect.wgsl",
  "params": {
    "type": "object",
    "properties": {
      "stops": {
        "type": "number",
        "minimum": -5,
        "maximum": 5,
        "default": 0,
        "description": "+1 doubles the light, -1 halves it.",
        "x-animatable": true
      }
    }
  }
}
