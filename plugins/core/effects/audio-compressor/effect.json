{
  "id": "core.audio/compressor",
  "version": "1.0.0",
  "kind": "audio",
  "runtime": "ffmpeg",
  "name": "Compressor",
  "description": "Even out loud and quiet moments: sound above the threshold is turned down by the ratio. Add makeup gain to bring the level back up.",
  "filter": "acompressor=threshold={threshold}dB:ratio={ratio}:attack={attack}:release={release}:makeup={makeup}dB",
  "params": {
    "type": "object",
    "properties": {
      "threshold": {
        "type": "number",
        "minimum": -60,
        "maximum": 0,
        "default": -18,
        "description": "Level where compression starts, dBFS.",
        "x-animatable": true
      },
      "ratio": {
        "type": "number",
        "minimum": 1,
        "maximum": 20,
        "default": 3,
        "description": "3 means 3 dB in above the threshold comes out as 1 dB.",
        "x-animatable": true
      },
      "attack": {
        "type": "number",
        "minimum": 0.01,
        "maximum": 2000,
        "default": 20,
        "description": "How fast it reacts, ms."
      },
      "release": {
        "type": "number",
        "minimum": 0.01,
        "maximum": 9000,
        "default": 250,
        "description": "How fast it lets go, ms."
      },
      "makeup": {
        "type": "number",
        "minimum": 0,
        "maximum": 36,
        "default": 0,
        "description": "Gain added after compression, dB.",
        "x-animatable": true
      }
    }
  }
}
