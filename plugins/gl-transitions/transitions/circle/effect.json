{
 "id": "gl.transition/circle",
 "version": "1.0.0",
 "kind": "transition",
 "runtime": "wgsl",
 "name": "Circle",
 "description": "The outgoing image closes into a circle over a background color, then the incoming one opens from it (by Fernando Kuteken, license MIT, GL Transitions)",
 "shader": "transition.wgsl",
 "params": {
  "type": "object",
  "properties": {
   "center": {
    "title": "center",
    "description": "Center of the circle",
    "type": "array",
    "items": {
     "type": "number"
    },
    "minItems": 2,
    "maxItems": 2,
    "default": [
     0.5,
     0.5
    ],
    "x-animatable": true
   },
   "back_color": {
    "title": "backColor",
    "type": "array",
    "items": {
     "type": "number"
    },
    "minItems": 3,
    "maxItems": 3,
    "default": [
     0.1,
     0.1,
     0.1
    ],
    "x-animatable": true
   }
  }
 }
}
