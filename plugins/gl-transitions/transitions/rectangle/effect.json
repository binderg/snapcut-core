{
 "id": "gl.transition/rectangle",
 "version": "1.0.0",
 "kind": "transition",
 "runtime": "wgsl",
 "name": "Rectangle",
 "description": "A rectangle grows from the center to cover the outgoing image, then shrinks to reveal the incoming one (by martiniti, license MIT, GL Transitions)",
 "shader": "transition.wgsl",
 "params": {
  "type": "object",
  "properties": {
   "bgcolor": {
    "title": "bgcolor",
    "type": "array",
    "items": {
     "type": "number"
    },
    "minItems": 4,
    "maxItems": 4,
    "default": [
     0.0,
     0.0,
     0.0,
     1.0
    ],
    "x-animatable": true
   }
  }
 }
}
