{
 "id": "gl.transition/directionalwarp",
 "version": "1.0.0",
 "kind": "transition",
 "runtime": "wgsl",
 "name": "Directionalwarp",
 "description": "A diagonal wipe with a warped, smeared edge (by pschroen, license MIT, GL Transitions)",
 "shader": "transition.wgsl",
 "params": {
  "type": "object",
  "properties": {
   "smoothness": {
    "title": "smoothness",
    "description": "Softness of the edge",
    "type": "number",
    "default": 0.1,
    "x-animatable": true
   },
   "direction": {
    "title": "direction",
    "description": "Direction of the wipe",
    "type": "array",
    "items": {
     "type": "number"
    },
    "minItems": 2,
    "maxItems": 2,
    "default": [
     -1.0,
     1.0
    ],
    "x-animatable": true
   }
  }
 }
}
